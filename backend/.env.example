LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
# Optional: fast model for high-volume ops (query gen, evidence extraction).
# llama-3.1-8b-instant has higher TPM/TPD limits on Groq free tier.
LLM_MODEL_FAST=llama-3.1-8b-instant

# Optional: HuggingFace fallback (activated on Groq TPD exhaustion)
LLM_FALLBACK_PROVIDER=huggingface
LLM_FALLBACK_API_KEY=your_hf_token_here
LLM_FALLBACK_MODEL=Qwen/Qwen2.5-72B-Instruct

SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_tavily_api_key_here
DATABASE_URL=sqlite+aiosqlite:///./thread.db

# Increase this to reduce retry storms after provider exhaustion.
AGENT_CYCLE_INTERVAL_SECONDS=60
